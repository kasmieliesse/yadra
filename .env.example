# Copier ces variables dans Vercel → Project Settings → Environment Variables
# (jamais dans le code, jamais commité avec de vraies valeurs)

# Neon Postgres — depuis le dashboard Neon, "Connection string" (mode "Pooled connection")
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Adresse d'expédition des emails (doit appartenir à un domaine vérifié dans Resend,
# ou utiliser onboarding@resend.dev pour tester avant de vérifier yadra.fr)
EMAIL_FROM="yadra! <notifications@yadra.fr>"

# Où arrivent les notifications de demandes/contacts/candidatures
ADMIN_EMAIL=eliesse13100@proton.me

# URL publique du site (sert à construire les liens de vérification d'email)
APP_URL=https://yadra.fr
